:8000 {
    @unsafePath {
      path /.git/* /node_modules/* /vendor/* /.venv/*
    }
    respond @unsafePath 404

    # 同源转发 API，浏览器端无需暴露独立后端域名或处理跨域。
    handle /api/* {
      reverse_proxy https://scgplfqp5pk94ppvjm5bb.apigateway-cn-beijing.volceapi.com {
        header_up Host scgplfqp5pk94ppvjm5bb.apigateway-cn-beijing.volceapi.com
      }
    }

    handle {
      root * .

      # 只有带内容哈希的构建产物使用长期缓存。
      @hashedAssets path /assets/*
      header @hashedAssets Cache-Control "public, max-age=31536000, immutable"

      # 入口与 Service Worker 每次都检查新版本，避免旧壳长期驻留。
      @freshFiles path / /index.html /sw.js /manifest.webmanifest
      header @freshFiles Cache-Control "no-cache, no-store, must-revalidate"

      try_files {path} {path}.html {path}/index.html 404.html index.html
      file_server
    }

    log {
      output stderr
    }
}
